<mujoco model="go2 stairs scene">
  <!--
    GENERATED by terrain/stairs.py -- do not edit by hand.

    Phase 2 training scene: Go2 on a 1-step staircase with a 2.0 m flat
    approach and a 2.0 m landing platform.

    Every stair box is a MOCAP body, so its pose comes from mjx.Data.mocap_pos and is
    therefore per-env under vmap. That is what lets one compiled model present a
    different staircase (rise, run, yaw) to each of the 8192 parallel envs, which
    plan.md 2.4's per-env curriculum requires. Box sizes are model fields and cannot
    vary per env, so both stair dimensions are encoded as positions -- see
    terrain/stairs.py for why that yields an exactly correct staircase anyway.

    Box geoms only, no heightfields (plan.md 0.6): MJX handles heightfield contacts
    poorly, and box/sphere contacts are exact for a Go2's spherical feet.

    The robot model is included UNMODIFIED from mujoco_menagerie, as in scene_flat.xml.
  -->
  <include file="go2z1_mjx.xml"/>

  <statistic center="2.17 0 0.5" extent="2.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20" offwidth="1920" offheight="1080"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="tread" rgba="0.55 0.55 0.6 1" reflectance="0.05"/>
  </asset>

  <worldbody>
    <light pos="0 0 3.0" dir="0 0 -1" directional="true"/>
    <!-- friction is a named handle for domain randomization (plan.md 2.6); the foot
         geoms carry condim=6 + priority=1 from the robot model, so foot contact
         parameters win at every foot-terrain contact regardless. -->
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"
      condim="3" friction="0.8 0.02 0.01"/>
    <body name="step0" mocap="true" pos="2.17500 0.00000 -0.25000">
      <geom name="step0_geom" type="box" size="0.17500 1.25000 0.40000"
        material="tread" condim="3" friction="0.8 0.02 0.01"/>
    </body>
    <body name="landing" mocap="true" pos="3.28000 0.00000 -0.25000">
      <geom name="landing_geom" type="box" size="1.00000 1.25000 0.40000"
        material="tread" condim="3" friction="0.8 0.02 0.01"/>
    </body>
  </worldbody>

  <contact>
    <!-- The floor plane and the stair boxes are all welded to the world, so contacts
         between them can never produce motion -- they only widen MJX's contact array
         (sized at compile time from candidate geom pairs) and cost VRAM in every one
         of the 8192 envs. Excluded explicitly. -->
    <exclude body1="world" body2="step0"/>
    <exclude body1="world" body2="landing"/>
  </contact>
</mujoco>
